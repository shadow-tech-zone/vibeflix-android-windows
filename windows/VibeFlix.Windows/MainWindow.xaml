<Window
    x:Class="VibeFlix.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VibeFlix">
    <Grid x:Name="AppRoot" Background="#0A0D13" RequestedTheme="Dark" SizeChanged="AppRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="24,0"
            Background="#10151E"
            BorderBrush="#252D3A"
            BorderThickness="0,0,0,1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="12" Background="#8769E8">
                        <TextBlock
                            Text="V"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="VibeFlix" FontSize="20" FontWeight="SemiBold" Foreground="#F3F5FA" />
                        <TextBlock x:Name="BrandSubtitle" Text="YOUR PERSONAL LIBRARY" FontSize="9" CharacterSpacing="100" Foreground="#919CAF" />
                    </StackPanel>
                </StackPanel>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Height="42"
                    Margin="16,0,16,0"
                    Padding="14,0"
                    VerticalContentAlignment="Center"
                    PlaceholderText="Search titles, people, genres"
                    Background="#171D28"
                    BorderBrush="#303A4B"
                    BorderThickness="1"
                    Foreground="#F2F4F8"
                    FontSize="14"
                    AutomationProperties.Name="Search catalogue"
                    TextChanged="SearchBox_TextChanged"
                    KeyDown="SearchBox_KeyDown" />

                <ComboBox
                    x:Name="ServerPicker"
                    Grid.Column="2"
                    Width="150"
                    Height="40"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Filter by catalogue source"
                    SelectionChanged="ServerPicker_SelectionChanged">
                    <ComboBoxItem Content="Both Servers" />
                    <ComboBoxItem Content="Server 1" />
                    <ComboBoxItem Content="Server 2" />
                </ComboBox>

                <Border
                    x:Name="PreviewBadge"
                    Grid.Column="3"
                    Padding="12,8"
                    CornerRadius="10"
                    Background="#1B2331"
                    BorderBrush="#35445A"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#9BDBBD" />
                        <TextBlock Text="PREVIEW" FontSize="10" CharacterSpacing="110" FontWeight="SemiBold" Foreground="#C7D7D1" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border
            x:Name="NavigationSidebar"
            Grid.Row="1"
            Grid.Column="0"
            Padding="14,24,14,18"
            Background="#0D1118"
            BorderBrush="#252D3A"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="NavigationCaption"
                        Text="YOUR LIBRARY"
                        Margin="12,0,0,12"
                        FontSize="10"
                        CharacterSpacing="140"
                        FontWeight="SemiBold"
                        Foreground="#758195" />

                    <Button x:Name="HomeNav" Tag="Home" Click="NavigationButton_Click" AutomationProperties.Name="Home" HorizontalContentAlignment="Stretch" Padding="12,11" Background="#202736" BorderThickness="0" Foreground="#F3F5FA">
                        <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                            <SymbolIcon Symbol="Home" Foreground="#D8CAFF" />
                            <TextBlock x:Name="HomeNavLabel" Text="Home" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SearchNav" Tag="Search" Click="NavigationButton_Click" AutomationProperties.Name="Search" HorizontalContentAlignment="Stretch" Padding="12,11" Background="Transparent" BorderThickness="0" Foreground="#BAC3D1">
                        <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                            <SymbolIcon Symbol="Find" Foreground="#AAB5C6" />
                            <TextBlock x:Name="SearchNavLabel" Text="Search" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MyListNav" Tag="My List" Click="NavigationButton_Click" AutomationProperties.Name="My List" HorizontalContentAlignment="Stretch" Padding="12,11" Background="Transparent" BorderThickness="0" Foreground="#BAC3D1">
                        <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                            <SymbolIcon Symbol="Favorite" Foreground="#AAB5C6" />
                            <TextBlock x:Name="MyListNavLabel" Text="My List" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ContinueNav" Tag="Continue Watching" Click="NavigationButton_Click" AutomationProperties.Name="Continue Watching" HorizontalContentAlignment="Stretch" Padding="12,11" Background="Transparent" BorderThickness="0" Foreground="#BAC3D1">
                        <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                            <SymbolIcon Symbol="Play" Foreground="#AAB5C6" />
                            <TextBlock x:Name="ContinueNavLabel" Text="Continue Watching" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HistoryNav" Tag="History" Click="NavigationButton_Click" AutomationProperties.Name="History" HorizontalContentAlignment="Stretch" Padding="12,11" Background="Transparent" BorderThickness="0" Foreground="#BAC3D1">
                        <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                            <SymbolIcon Symbol="History" Foreground="#AAB5C6" />
                            <TextBlock x:Name="HistoryNavLabel" Text="History" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Border Height="1" Margin="10,14,10,12" Background="#252D3A" />
                    <Button x:Name="SettingsNav" Tag="Settings" Click="NavigationButton_Click" AutomationProperties.Name="Settings" HorizontalContentAlignment="Stretch" Padding="12,11" Background="Transparent" BorderThickness="0" Foreground="#BAC3D1">
                        <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                            <SymbolIcon Symbol="Setting" Foreground="#AAB5C6" />
                            <TextBlock x:Name="SettingsNavLabel" Text="Settings" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border
                    x:Name="LocalOnlyCard"
                    Grid.Row="1"
                    Padding="14"
                    CornerRadius="12"
                    Background="#151B25"
                    BorderBrush="#2B3544"
                    BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="LocalOnlyTitle" Text="LOCAL FIRST" FontSize="10" CharacterSpacing="110" FontWeight="SemiBold" Foreground="#AEB9C9" />
                        <TextBlock x:Name="LocalOnlyDescription" Text="This preview keeps library actions on this device." FontSize="11" TextWrapping="Wrap" Foreground="#8793A6" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Background="#0A0D13">
            <ScrollViewer
                x:Name="PageScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                SizeChanged="PageScrollViewer_SizeChanged">
                <StackPanel x:Name="PageContent" Margin="34,28,34,48" Spacing="24" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
