<Window
    x:Class="VibeFlix.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VibeFlix">
    <Grid x:Name="AppRoot" Background="#000000" RequestedTheme="Dark" SizeChanged="AppRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="26,0"
            Background="#000000"
            BorderBrush="Transparent"
            BorderThickness="0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="VibeFlix"
                    FontSize="23"
                    FontWeight="Bold"
                    CharacterSpacing="15"
                    Foreground="#E34855"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="VibeFlix home" />

                <ScrollViewer
                    x:Name="NavigationScrollViewer"
                    Grid.Column="1"
                    Margin="18,0,12,0"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Button x:Name="HomeNav" Tag="Home" Click="NavigationButton_Click" AutomationProperties.Name="Home" Content="Home" Padding="10,12" Background="Transparent" BorderBrush="#E34855" BorderThickness="0,0,0,2" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                        <Button x:Name="SeriesNav" Tag="Series" Click="NavigationButton_Click" AutomationProperties.Name="TV Shows" Content="TV Shows" Padding="10,12" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                        <Button x:Name="MoviesNav" Tag="Movies" Click="NavigationButton_Click" AutomationProperties.Name="Movies" Content="Movies" Padding="10,12" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                        <Button x:Name="SearchNav" Tag="Search" Click="NavigationButton_Click" AutomationProperties.Name="Browse catalogue" Content="Browse" Padding="10,12" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                        <Button x:Name="MyListNav" Tag="My List" Click="NavigationButton_Click" AutomationProperties.Name="My List" Content="My List" Padding="10,12" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                        <Button x:Name="ContinueNav" Tag="Continue Watching" Click="NavigationButton_Click" AutomationProperties.Name="Continue Watching" Content="Continue Watching" Padding="10,12" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                        <Button x:Name="MoreNav" Tag="More" Click="MoreNavigationButton_Click" AutomationProperties.Name="More navigation options" Content="More" Padding="10,12" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <TextBox
                        x:Name="SearchBox"
                        Width="220"
                        Height="36"
                        Padding="11,0"
                        VerticalContentAlignment="Center"
                        PlaceholderText="Search"
                        Background="#2D2D2D"
                        BorderBrush="#414141"
                        BorderThickness="1"
                        Foreground="#F5F5F5"
                        FontSize="13"
                        AutomationProperties.Name="Search catalogue"
                        TextChanged="SearchBox_TextChanged"
                        KeyDown="SearchBox_KeyDown" />

                    <ComboBox
                        x:Name="ServerPicker"
                        Width="140"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="#161616"
                        BorderBrush="#414141"
                        Foreground="#FFFFFF"
                        AutomationProperties.Name="Filter by catalogue source"
                        SelectionChanged="ServerPicker_SelectionChanged">
                        <ComboBoxItem Content="Both Servers" />
                        <ComboBoxItem Content="Server 1" />
                        <ComboBoxItem Content="Server 2" />
                    </ComboBox>

                    <Border
                        x:Name="PreviewBadge"
                        Padding="9,7"
                        CornerRadius="4"
                        Background="#161616"
                        BorderBrush="#414141"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#808080" />
                            <TextBlock Text="SOURCES" FontSize="9" CharacterSpacing="45" FontWeight="SemiBold" Foreground="#E0E0E0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#000000">
            <ScrollViewer
                x:Name="PageScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                SizeChanged="PageScrollViewer_SizeChanged">
                <StackPanel x:Name="PageContent" Margin="0,0,0,48" Spacing="20" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
