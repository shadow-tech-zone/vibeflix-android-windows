<Window
    x:Class="VibeFlix.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VibeFlix">
    <Grid x:Name="AppRoot" Background="#090B10" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="26,0"
            Background="#10131B"
            BorderBrush="#252B38"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="11" Background="#7858E8">
                        <TextBlock
                            Text="V"
                            FontSize="21"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="VibeFlix" FontSize="20" FontWeight="SemiBold" Foreground="#F3F5FA" />
                        <TextBlock Text="YOUR PERSONAL LIBRARY" FontSize="9" CharacterSpacing="100" Foreground="#8D97A9" />
                    </StackPanel>
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Padding="12,7"
                    CornerRadius="12"
                    Background="#171C27"
                    BorderBrush="#293142"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <TextBlock Text="LOCAL-FIRST" FontSize="10" CharacterSpacing="110" FontWeight="SemiBold" Foreground="#B9C2D2" />
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Padding="18,26,16,20"
            Background="#0D1017"
            BorderBrush="#252B38"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="7">
                    <TextBlock
                        Text="LIBRARY"
                        Margin="11,0,0,10"
                        FontSize="10"
                        CharacterSpacing="150"
                        FontWeight="SemiBold"
                        Foreground="#758095" />
                    <Button Content="Home" Tag="Home" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Padding="13,11" Background="#1B2030" BorderThickness="0" Foreground="#F3F5FA" FontSize="14" />
                    <Button x:Name="SearchNav" Content="Search" Tag="Search" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Padding="13,11" Background="Transparent" BorderThickness="0" Foreground="#C2C9D5" FontSize="14" />
                    <Button Content="My List" Tag="My List" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Padding="13,11" Background="Transparent" BorderThickness="0" Foreground="#C2C9D5" FontSize="14" />
                    <Button Content="History" Tag="History" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Padding="13,11" Background="Transparent" BorderThickness="0" Foreground="#C2C9D5" FontSize="14" />
                    <Border Height="1" Margin="10,17,10,11" Background="#252B38" />
                    <Button Content="Settings" Tag="Settings" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Padding="13,11" Background="Transparent" BorderThickness="0" Foreground="#C2C9D5" FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="9,0,5,2" Spacing="5">
                    <TextBlock Text="Keyboard and mouse ready" FontSize="12" FontWeight="SemiBold" Foreground="#C8CFDB" />
                    <TextBlock Text="Use Tab and Shift+Tab to move, then Enter or Space to select." FontSize="11" TextWrapping="Wrap" Foreground="#818B9D" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="36,30,36,48">
                <StackPanel x:Name="HomeView" Spacing="25">
                    <StackPanel Spacing="5">
                        <TextBlock Text="YOUR HOME" FontSize="11" CharacterSpacing="150" FontWeight="SemiBold" Foreground="#A990FF" />
                        <TextBlock Text="A good story starts here." FontSize="31" FontWeight="SemiBold" Foreground="#F3F5FA" />
                    </StackPanel>

                    <Border Height="310" CornerRadius="18" BorderBrush="#30374A" BorderThickness="1">
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#17233A" Offset="0" />
                                    <GradientStop Color="#1B1832" Offset="0.55" />
                                    <GradientStop Color="#111720" Offset="1" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Ellipse Width="300" Height="300" Fill="#332775A8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,70,0" />
                            <Ellipse Width="185" Height="185" Fill="#3358B6A9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,205,0" />
                            <Border Width="5" HorizontalAlignment="Left" Background="#9A7BFF" />
                            <StackPanel Margin="38,26,24,26" MaxWidth="560" VerticalAlignment="Center" Spacing="13">
                                <TextBlock Text="MAKE IT A VIBE" FontSize="11" CharacterSpacing="160" FontWeight="SemiBold" Foreground="#C9BDFF" />
                                <TextBlock Text="Find your next favorite." FontSize="38" FontWeight="Bold" TextWrapping="Wrap" Foreground="#FFFFFF" />
                                <TextBlock
                                    Text="Browse Server 1, Server 2, or both. Your library stays on this device first, with syncing always opt-in."
                                    FontSize="15"
                                    MaxWidth="495"
                                    TextWrapping="Wrap"
                                    LineHeight="23"
                                    Foreground="#C3CAD8" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                    <Button Content="Browse titles" Click="BrowseButton_Click" Padding="18,10" Background="#8969F2" BorderThickness="0" Foreground="#FFFFFF" FontWeight="SemiBold" />
                                    <Button Content="My List" Tag="My List" Click="NavigationButton_Click" Padding="18,10" Background="#242B3A" BorderBrush="#394255" BorderThickness="1" Foreground="#E6EAF2" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Your space" FontSize="21" FontWeight="SemiBold" Foreground="#F0F2F7" />
                            <TextBlock Text="Local library" FontSize="12" VerticalAlignment="Center" Foreground="#929CAF" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,9,0" Padding="20" CornerRadius="13" Background="#121721" BorderBrush="#282F3D" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="CONTINUE WATCHING" FontSize="10" CharacterSpacing="110" FontWeight="SemiBold" Foreground="#9AA5B8" />
                                    <TextBlock Text="Pick up where you left off." FontSize="17" FontWeight="SemiBold" Foreground="#E8EBF2" />
                                    <TextBlock Text="Playback progress will appear here when the Windows player is connected." FontSize="13" TextWrapping="Wrap" Foreground="#929CAF" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="9,0,0,0" Padding="20" CornerRadius="13" Background="#121721" BorderBrush="#282F3D" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="MY LIST" FontSize="10" CharacterSpacing="110" FontWeight="SemiBold" Foreground="#9AA5B8" />
                                    <TextBlock Text="Keep your favorites close." FontSize="17" FontWeight="SemiBold" Foreground="#E8EBF2" />
                                    <TextBlock Text="Saved titles will be stored locally first. Nothing is synced unless you choose to enable it." FontSize="13" TextWrapping="Wrap" Foreground="#929CAF" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="EmptySectionView" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="22">
                    <StackPanel Spacing="7">
                        <TextBlock x:Name="SectionEyebrow" FontSize="11" CharacterSpacing="150" FontWeight="SemiBold" Foreground="#A990FF" />
                        <TextBlock x:Name="SectionTitle" FontSize="31" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#F3F5FA" />
                        <TextBlock x:Name="SectionDescription" FontSize="15" TextWrapping="Wrap" Foreground="#AAB3C3" />
                    </StackPanel>
                    <Border Padding="26" CornerRadius="15" Background="#121721" BorderBrush="#282F3D" BorderThickness="1">
                        <StackPanel Spacing="9">
                            <TextBlock x:Name="EmptyStateTitle" FontSize="19" FontWeight="SemiBold" Foreground="#E8EBF2" />
                            <TextBlock x:Name="EmptyStateDescription" FontSize="14" TextWrapping="Wrap" Foreground="#929CAF" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
