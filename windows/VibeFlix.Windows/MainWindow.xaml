<Window
    x:Class="VibeFlix.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VibeFlix">
    <Grid x:Name="AppRoot" Background="#080808" RequestedTheme="Dark" SizeChanged="AppRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="28,0"
            Background="#080808"
            BorderBrush="#242424"
            BorderThickness="0,0,0,1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="30" Height="34" CornerRadius="5" Background="#D92738">
                        <TextBlock
                            Text="V"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="VibeFlix" FontSize="21" FontWeight="Bold" Foreground="#E34855" />
                        <TextBlock x:Name="BrandSubtitle" Text="LOCAL PREVIEW" FontSize="9" CharacterSpacing="90" Foreground="#A0A0A0" />
                    </StackPanel>
                </StackPanel>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Width="270"
                    Height="38"
                    Margin="16,0,14,0"
                    Padding="12,0"
                    HorizontalAlignment="Right"
                    VerticalContentAlignment="Center"
                    PlaceholderText="Search titles, people, genres"
                    Background="#151515"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    Foreground="#F5F5F5"
                    FontSize="13"
                    AutomationProperties.Name="Search catalogue"
                    TextChanged="SearchBox_TextChanged"
                    KeyDown="SearchBox_KeyDown" />

                <ComboBox
                    x:Name="ServerPicker"
                    Grid.Column="2"
                    Width="148"
                    Height="38"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Filter by catalogue source"
                    SelectionChanged="ServerPicker_SelectionChanged">
                    <ComboBoxItem Content="Both Servers" />
                    <ComboBoxItem Content="Server 1" />
                    <ComboBoxItem Content="Server 2" />
                </ComboBox>

                <Border
                    x:Name="PreviewBadge"
                    Grid.Column="3"
                    Padding="11,8"
                    CornerRadius="6"
                    Background="#191919"
                    BorderBrush="#373737"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#E34855" />
                        <TextBlock Text="SAMPLE MODE" FontSize="9" CharacterSpacing="65" FontWeight="SemiBold" Foreground="#E0E0E0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Background="#080808"
            BorderBrush="#222222"
            BorderThickness="0,0,0,1">
            <ScrollViewer
                x:Name="NavigationScrollViewer"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="18,0" VerticalAlignment="Stretch">
                    <Button x:Name="HomeNav" Tag="Home" Click="NavigationButton_Click" AutomationProperties.Name="Home" Content="Home" Padding="14,10" Background="#191919" BorderBrush="#E34855" BorderThickness="0,0,0,2" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                    <Button x:Name="SeriesNav" Tag="Series" Click="NavigationButton_Click" AutomationProperties.Name="TV Shows" Content="TV Shows" Padding="14,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                    <Button x:Name="MoviesNav" Tag="Movies" Click="NavigationButton_Click" AutomationProperties.Name="Movies" Content="Movies" Padding="14,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                    <Button x:Name="SearchNav" Tag="Search" Click="NavigationButton_Click" AutomationProperties.Name="Search" Content="Search" Padding="14,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                    <Button x:Name="MyListNav" Tag="My List" Click="NavigationButton_Click" AutomationProperties.Name="My List" Content="My List" Padding="14,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                    <Button x:Name="ContinueNav" Tag="Continue Watching" Click="NavigationButton_Click" AutomationProperties.Name="Continue Watching" Content="Continue Watching" Padding="14,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                    <Button x:Name="HistoryNav" Tag="History" Click="NavigationButton_Click" AutomationProperties.Name="History" Content="History" Padding="14,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                    <Button x:Name="SettingsNav" Tag="Settings" Click="NavigationButton_Click" AutomationProperties.Name="Settings" Content="Settings" Padding="14,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Foreground="#B3B3B3" FontSize="13" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Background="#080808">
            <ScrollViewer
                x:Name="PageScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                SizeChanged="PageScrollViewer_SizeChanged">
                <StackPanel x:Name="PageContent" Margin="34,22,34,48" Spacing="24" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
